# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/

# Keystore files
*.jks
*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (e.g. APIs or Firebase)
google-services.json

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output

# Version control
vcs.xml

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/

# Kotlin
.kotlin/

# OS
.DS_Store
Thumbs.db

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files
# NOTE: gradle/wrapper/gradle-wrapper.jar is force-added and must stay committed —
# without it ./gradlew cannot bootstrap on a fresh clone. Keep the negation below.
*.jar
!gradle/wrapper/gradle-wrapper.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Virtual machine crash logs
hs_err_pid*
replay_pid*

# AI tool config — may contain API keys; never commit real keys.
# providers.yaml is already tracked (it holds only a public free-tier placeholder key),
# so this pattern does NOT apply to it — .gitignore never affects tracked files. If you
# ever put a real key in it, run `git rm --cached providers.yaml` first, otherwise the
# change will be committed silently. Copy providers.yaml.example for local overrides.
providers.yaml.local

# AI tool session data (may contain sensitive conversation content) and deps
.opencode/goals/
.opencode/node_modules/

# AI assistant local state. These hold machine-specific paths and permission grants,
# not project config. Previously only ignored via a global ~/.config/git/ignore, so a
# fresh clone on another machine would have surfaced them as untracked.
.claude/settings.local.json
.claude/settings.local.json.tmp.*
.claude/worktrees/

# Working notes written during development sessions; not part of the project
HANDOFF.md
