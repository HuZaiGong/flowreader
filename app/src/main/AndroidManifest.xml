<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      The only network code in the app is LAN-only: the OPDS client and the LAN backup transfer.
      Both validate the peer address themselves (`OpdsAddress.isPrivateHost()`) — loopback,
      RFC1918, RFC4193 and `.local`-style names only. Nothing else opens a socket, and no
      analytics, crash reporting or sync exists. See the "否决清单" section of ROADMAP.md.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"
        tools:ignore="ScopedStorage" />

    <!--
      v56.6.2 (static-review finding #7): the exported ContentProvider is now gated by a custom
      permission. Read-only book metadata and progress is still deliberately available to other
      apps on the device (automation tools, launchers) — that is what the provider is for — but
      an app now has to declare this permission AND have the user grant it at runtime, instead
      of reading the whole library silently the moment it is installed.

      `dangerous` and not `signature` on purpose: `signature` would restrict the provider to
      apps signed with this repo's key, which deletes the feature rather than gating it.
      The write permission is `signature` (so effectively never granted) purely as a second
      layer — `insert`/`update`/`delete` already throw in FlowReaderContentProvider.
    -->
    <permission
        android:name="com.flowreader.app.permission.READ_LIBRARY"
        android:label="@string/permission_read_library_label"
        android:description="@string/permission_read_library_description"
        android:protectionLevel="dangerous" />

    <permission
        android:name="com.flowreader.app.permission.WRITE_LIBRARY"
        android:label="@string/permission_write_library_label"
        android:description="@string/permission_write_library_description"
        android:protectionLevel="signature" />

    <application
        android:name=".FlowReaderApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FlowReader"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FlowReader"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/epub+zip" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <provider
            android:name="com.flowreader.app.provider.FlowReaderContentProvider"
            android:authorities="com.flowreader.app.provider"
            android:exported="true"
            android:enabled="true"
            android:readPermission="com.flowreader.app.permission.READ_LIBRARY"
            android:writePermission="com.flowreader.app.permission.WRITE_LIBRARY"
            android:multiprocess="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".widget.ReadingProgressWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/reading_progress_widget_info" />
        </receiver>
    </application>

</manifest>
