<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProvider paths (v56.4.1 security fix: narrowed from whole-root grants).

  There is exactly one getUriForFile() call site in the app — the reader's
  "分享阅读卡片" action (ReaderScreen -> ShareCardGenerator) — so this file grants
  exactly one directory. Keep it that way: every path listed here is reachable by
  any app holding a granted URI.

  Removed in v56.4.1 (each exposed a whole tree with no consumer):
  - <external-path path="." />  never used at all
  - <files-path path="." />     covers/ is read in-process by Coil, never shared
  - <cache-path path="." />     opds/ downloads are imported in-process; the LAN
                                backup JSON is served over LanTransferServer's own
                                token-guarded socket, not through FileProvider

  If a new share path is ever needed, add the narrowest subdirectory that works and
  point the writing code at it — do not widen these back to ".".
-->
<paths>
    <!-- Reader share cards; must match ShareCardGenerator.SHARE_CARD_DIR -->
    <cache-path name="share_cards" path="share_cards/" />
</paths>
