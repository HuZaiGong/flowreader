# providers.yaml.example - 第三方 LLM 提供商配置模板
# 使用: cp providers.yaml.example providers.yaml 后按需修改。
# API key 请用 {env:VAR_NAME} 引用环境变量, 不要明文写入并提交到 git。
# 增删改后重启 opencode 即可生效

ollama:
  name: "Ollama (local)"
  npm: "@ai-sdk/openai-compatible"
  base_url: "http://localhost:11434/v1"
  models:
    llama3.2:
      name: "Llama 3.2"

